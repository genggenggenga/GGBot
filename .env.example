# GGBot 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ── 应用 ──────────────────────────────────────────────────────────────────────
APP_NAME=GGBot
APP_ENV=production
LOG_LEVEL=INFO

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Anthropic Claude ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 可选：覆盖为兼容 Anthropic 协议的第三方 API（如 DeepSeek）
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# 可选：覆盖模型名称（默认 claude-3-5-sonnet-20241022）
# 使用 DeepSeek V4 时设为 deepseek-v4-pro；低成本/高并发场景可用 deepseek-v4-flash
# ANTHROPIC_MODEL=deepseek-v4-pro

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=ggbot123

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma

# ── RAG Embedding / Reranker ─────────────────────────────────────────────────
# provider: api（走 SiliconFlow，无需本地 torch）| local（本地 BGE，需 torch）| off（仅 BM25）
RAG_EMBEDDING_PROVIDER=api
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_DENSE_THRESHOLD=0.2
RAG_RRF_THRESHOLD=0.01
RAG_RERANK_THRESHOLD=0.1
# 文档切片使用模型无关 token 预算；修改后只影响新导入或重新索引的文档。
RAG_CHUNK_SIZE_TOKENS=500
RAG_CHUNK_OVERLAP_TOKENS=80
# KnowledgeAgent 问题改写：一次 LLM 调用完成指代消解与 Multi-Query。
RAG_MULTI_QUERY_ENABLED=true
RAG_MULTI_QUERY_MAX_QUERIES=3
RAG_QUERY_REWRITE_MIN_CONFIDENCE=0.5
# 兼容旧配置；设置后会覆盖上面三个分模式阈值：
# RAG_RELEVANCE_THRESHOLD=0.2
# 仅 provider=api 时需要：
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# 兼容旧开关：RAG_LOCAL_MODELS_ENABLED=false 等价于 provider=off

# ── 监控 ──────────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
ANOMALY_DETECTION_THRESHOLD=2.0

# ── 评测 ──────────────────────────────────────────────────────────────────────
EVAL_BASELINE_PATH=./data/eval/baseline.json

# ── Skills ───────────────────────────────────────────────────────────────────
# 默认读取项目内 ./skills，支持运行时通过 POST /skills/reload 热加载
GGBOT_SKILLS_DIR=./skills
GGBOT_SKILLS_MAX_PROMPT_CHARS=5000

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# 默认关闭旧 AgentOrchestrator + LLM-as-Judge，仅显式需要 legacy 评测时开启。
ENABLE_LEGACY_EVAL=false
