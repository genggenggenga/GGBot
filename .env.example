# GGBot 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ── 应用 ──────────────────────────────────────────────────────────────────────
APP_NAME=GGBot
APP_ENV=production
LOG_LEVEL=INFO

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Anthropic Claude ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 可选：覆盖为兼容 Anthropic 协议的第三方 API（如 DeepSeek）
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# 可选：覆盖模型名称（默认 claude-3-5-sonnet-20241022）
# 使用 DeepSeek V4 时设为 deepseek-v4-pro；低成本/高并发场景可用 deepseek-v4-flash
# ANTHROPIC_MODEL=deepseek-v4-pro

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=ggbot123
# 同一 user_id + conv_id 的分布式租约锁
CONVERSATION_LOCK_LEASE_S=60
CONVERSATION_LOCK_WAIT_TIMEOUT_S=30
CONVERSATION_LOCK_RETRY_INTERVAL_S=0.05
# 写 RPC 的 action_id 指纹、状态和结果保留时间
ACTION_IDEMPOTENCY_TTL_S=86400

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma

# ── RAG Embedding / Reranker ─────────────────────────────────────────────────
# provider: api（走 SiliconFlow，无需本地 torch）| local（本地 BGE，需 torch）| off（仅 BM25）
RAG_EMBEDDING_PROVIDER=api
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_DENSE_THRESHOLD=0.2
RAG_RRF_THRESHOLD=0.01
RAG_RERANK_THRESHOLD=0.1
# 文档切片使用模型无关 token 预算；修改后只影响新导入或重新索引的文档。
RAG_CHUNK_SIZE_TOKENS=500
RAG_CHUNK_OVERLAP_TOKENS=80
# KnowledgeAgent 问题改写：一次 LLM 调用完成指代消解与 Multi-Query。
RAG_MULTI_QUERY_ENABLED=true
RAG_MULTI_QUERY_MAX_QUERIES=3
RAG_QUERY_REWRITE_MIN_CONFIDENCE=0.5
# 重排后 Top-N 证据的受约束回答生成
RAG_GENERATION_ENABLED=true
RAG_ANSWER_MAX_CHUNKS=5
RAG_ANSWER_MAX_CONTEXT_TOKENS=1800
RAG_ANSWER_TIMEOUT_S=8
# 兼容旧配置；设置后会覆盖上面三个分模式阈值：
# RAG_RELEVANCE_THRESHOLD=0.2
# 结构化 NLU：普通意图、写操作意图和跨目标切换的最低置信度。
NLU_MIN_CONFIDENCE=0.65
NLU_ACTION_MIN_CONFIDENCE=0.85
NLU_SWITCH_MIN_CONFIDENCE=0.85
# 业务 Agent 使用受约束 ReAct；关闭后回退到确定性 next_action。
REACT_ENABLED=true
# 最终回答润色：仅处理达到长度门槛的 RAG 和多 Agent 完成回答。
RESPONSE_POLISH_ENABLED=true
RESPONSE_POLISH_MIN_CHARS=120
RESPONSE_POLISH_TIMEOUT_S=3
# 仅 provider=api 时需要：
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# 兼容旧开关：RAG_LOCAL_MODELS_ENABLED=false 等价于 provider=off

# ── 监控 ──────────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
ANOMALY_DETECTION_THRESHOLD=2.0

# ── Skills ───────────────────────────────────────────────────────────────────
# 默认读取项目内 ./skills，支持运行时通过 POST /skills/reload 热加载
GGBOT_SKILLS_DIR=./skills
GGBOT_SKILLS_MAX_PROMPT_CHARS=5000

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
